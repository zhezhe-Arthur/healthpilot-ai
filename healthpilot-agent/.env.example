# ==========================================
# 应用环境配置
# ==========================================

APP_ENV=development

# ==========================================
# DeepSeek 大语言模型配置
# ==========================================

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ==========================================
# Java 业务后端配置
# ==========================================

JAVA_SERVER_URL=http://localhost:8080

# ==========================================
# Qwen3Guard 安全模型配置
# ==========================================

# 本地 Ollama 服务地址
# 远程部署时替换为实际服务地址，例如：
# https://guard.example.com
GUARD_BASE_URL=http://127.0.0.1:11434

# Qwen3Guard 安全模型名称
GUARD_MODEL=hf.co/ShahzebKhoso/Qwen3Guard-Gen-8B-GGUF:Q4_K_M

# 远程服务认证密钥，本地留空
GUARD_API_KEY=

# 单次请求超时时间（秒）
GUARD_TIMEOUT=120

# 最大尝试次数（包含首次请求）
GUARD_MAX_ATTEMPTS=3

# 重试等待时间（秒）
GUARD_RETRY_DELAY=0.5